{
  "name": "sport",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/service-worker.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "test:cloud": "firebase emulators:exec --only firestore,auth --project demo-sport \"node --experimental-strip-types --test tests/emulator/*.test.ts\""
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.6",
    "firebase-tools": "^14.27.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
